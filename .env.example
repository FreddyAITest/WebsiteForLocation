# ==========================================
# Google Maps & Google OAuth Konfiguration
# ==========================================

# 1. Google Cloud Serverless API-Key (wird in Netlify Environment Variables hinterlegt)
# Notwendig für die Abfrage der Directions API (ÖPNV-Abfahrten, Live-Verkehr, Dauer)
GOOGLE_MAPS_API_KEY=AIzaSy...

# 2. Google OAuth 2.0 Web Client-ID (öffentlich für das Frontend)
# Erstellt unter Google Cloud Console > APIs & Dienste > Anmeldedaten > OAuth-Client-ID (Webanwendung)
# Autorisierte JavaScript-Herkünfte: http://localhost:3000 und https://deine-seite.netlify.app
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# 3. Optional: Maps JavaScript API Key für direkte Frontend-Karten
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...
